<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONTROLGASTOS"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:gravity="center"
            android:letterSpacing="0.03" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Controla tu dinero, alcanza tus metas"
            android:textSize="15sp"
            android:textColor="#718096"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_tarjeta">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bienvenido"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#17365D"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingresa tu nombre para continuar."
                android:textSize="14sp"
                android:textColor="#718096"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu nombre"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#263A53"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Escribe tu nombre"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#263A53"
                android:textColorHint="#8A97A8"
                android:backgroundTint="#C8D4E2"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:minHeight="48dp"
                android:text="Continuar"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#17365D" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tus gastos, organizados en un solo lugar."
            android:textSize="12sp"
            android:textColor="#8A97A8"
            android:gravity="center"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>

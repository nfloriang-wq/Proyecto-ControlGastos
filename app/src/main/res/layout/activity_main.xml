<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="22dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTROLGASTOS"
                    android:textColor="#17365D"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Administra tu dinero con claridad"
                    android:textColor="#718096"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Salir"
                android:textAllCaps="false"
                android:textColor="#17365D"
                android:backgroundTint="#E1EAF5" />

        </LinearLayout>

        <!-- Saludo personalizado -->
        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hola 👋"
            android:textColor="#17365D"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Presupuesto mensual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_tarjeta_total"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PRESUPUESTO MENSUAL"
                android:textColor="#D8E5F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvSueldo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sueldo mensual: Q0.00"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvGastosMes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gastos del mes: Q0.00"
                android:textColor="#D8E5F5"
                android:textSize="16sp"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvDisponible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dinero disponible: Q0.00"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Registrar sueldo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi sueldo mensual"
            android:textColor="#17365D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_tarjeta"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingresa tu sueldo mensual en quetzales"
                android:textColor="#263A53"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSueldo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="Ej. 3500.00"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textColor="#263A53"
                android:textColorHint="#8A97A8"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnGuardarSueldo"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:minHeight="48dp"
                android:text="Guardar sueldo"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#17365D" />

        </LinearLayout>

        <!-- Versículo del día -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_tarjeta"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VERSÍCULO DEL DÍA"
                android:textColor="#17365D"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvVersiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando versículo..."
                android:textColor="#344256"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/tvReferencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#526F91"
                android:textSize="14sp"
                android:textStyle="italic"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- Formulario de gastos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar nuevo gasto"
            android:textColor="#17365D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_tarjeta">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción del gasto"
                android:textColor="#263A53"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="Ej. Compra de alimentos"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:textColor="#263A53"
                android:textColorHint="#8A97A8"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monto en quetzales (Q)"
                android:textColor="#263A53"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etMonto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="Ej. 50.00"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textColor="#263A53"
                android:textColorHint="#8A97A8"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Categoría"
                android:textColor="#263A53"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:minHeight="48dp"
                android:text="Guardar gasto"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#17365D" />

        </LinearLayout>

        <!-- Total de gastos registrados -->
        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total de gastos: Q0.00"
            android:textColor="#17365D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <!-- Lista de gastos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mis gastos"
            android:textColor="#17365D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_tarjeta">

            <TextView
                android:id="@+id/tvListaGastos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Todavía no hay gastos registrados"
                android:textColor="#526579"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:paddingBottom="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
